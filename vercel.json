{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "royal-brand-woodworking-website.vercel.app" }],
      "destination": "https://www.royalbrandwoodworking.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "royal-brand-woodworking-website.vercel.app" }],
      "destination": "https://www.royalbrandwoodworking.com/:path*",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/booking",
      "permanent": true
    },
    {
      "source": "/estimator",
      "destination": "/order",
      "permanent": true
    }
  ]
}
